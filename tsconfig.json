{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Self-name imports in examples/ and tests/fixtures/ must typecheck from
    // source on a fresh clone; dist declarations are validated separately by
    // tests/compat after a build.
    "paths": {
      "rayon-ts": ["./src/index.ts"],
      "rayon-ts/vite": ["./src/plugin/index.ts"],
      "rayon-ts/runtime": ["./src/runtime/registry.ts"]
    }
  },
  "include": ["src", "tests", "examples/**/*.ts", "vitest.config.ts"],
  "exclude": ["tests/.tmp", "tests/compat", "examples/**/dist"]
}
